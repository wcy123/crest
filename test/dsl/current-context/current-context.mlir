// The attribute shorthands in begin-mlir-code (:index, :i64, :f32, :string, ...) build
// attributes with (current-MLIRContext) by default. A pattern generated by
// define-rewrite-pattern / define-conversion-pattern installs it from the root op, so
// the shorthand works even when pass-entry-point has no surrounding with-current-MLIRContext
// (the pass here deliberately has none). See CLAUDE.md Rule 17.
//
// RUN: env CREST_PATH=%S CREST_SCHEME_BINARY_DIR=%t/scheme \
// RUN:   %crest-opt -allow-unregistered-dialect \
// RUN:   --crest-pass="passes=passes/current-context" %s 2>&1 \
// RUN:   | %FileCheck %s

// CHECK-LABEL: func.func @f
// CHECK:         %[[R:.*]] = "test.out"(%arg0) {idx = 0 : index} : (i32) -> i32
// CHECK-NEXT:    return %[[R]] : i32
// CHECK-NOT:     test.in

func.func @f(%a: i32) -> i32 {
  %0 = "test.in"(%a) : (i32) -> i32
  return %0 : i32
}

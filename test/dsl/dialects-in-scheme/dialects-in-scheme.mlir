// Tests that dialects-in-scheme= imports a Scheme library, calls
// get-dialect-descriptor (auto-generated by define-dialect), and registers
// the dialect factory via getDependentDialects before the pass pipeline enters
// multi-threaded mode. The pass queries getOrLoadDialect("testd") to verify
// the dialect is actually in the context when runOnOperation() runs.

// RUN: env CREST_PATH=%S \
// RUN:   %crest-opt %s \
// RUN:   --crest-pass="dialects-in-scheme=testd=passes/test-dialect \
// RUN:                 passes=passes/dialects-in-scheme" \
// RUN:   | %FileCheck %s

// CHECK: dialect-loaded: testd

module {}

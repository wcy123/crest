bu crest_opt!mlir::OpBuilder::insert "r $t0 = @rcx+0x20; .printf \"first insert: builder=%p block=%p +18=%p +20=%p\\n\", @rcx, poi(@rcx+0x10), poi(@rcx+0x18), poi(@$t0); bc 0; ba w8 @$t0 \"$$>< tools/experiment/write.cdb\"; g"
g
.printf "crash: rdi=%p watched=%p value-at-watched=%p\n", @rdi, @$t0, poi(@$t0)
.echo crash builder (rdi+0x10 ..):
dq @rdi+0x10 L6
.echo watched builder (watched-0x10 ..):
dq @$t0-0x10 L6
.echo stack pointer and top-level block
r rsp
q

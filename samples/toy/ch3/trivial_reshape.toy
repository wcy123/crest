# Mirrors mlir/test/Examples/Toy/Ch3/trivial_reshape.toy
# Every `var` with a declared shape is a reshape. With --opt the reshapes to the
# type the value already has are removed, and the reshape of the constant is folded.

def main() {
  var a<2,1> = [1, 2];
  var b<2,1> = a;
  var c<2,1> = b;
  print(c);
}

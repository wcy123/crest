#!/usr/bin/env bash
# Toy compiler Ch6 entry point.
# Usage: toyc <input.toy> [--emit=ast|--emit=mlir|--emit=mlir-affine|--emit=mlir-llvm|--emit=llvm|--emit=jit] [--opt]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -n "${CREST_BUILD_DIR:-}" ]]; then
    SCHEME_MLIR="$CREST_BUILD_DIR/tools/scheme-mlir/scheme-mlir"
else
    SCHEME_MLIR="$(command -v scheme-mlir || true)"
fi
[[ -x "$SCHEME_MLIR" ]] || { echo "Error: scheme-mlir not found. Set CREST_BUILD_DIR or add scheme-mlir to PATH." >&2; exit 1; }
CREST_PATH="$(realpath "$SCRIPT_DIR/../..")" \
"$SCHEME_MLIR" "$SCRIPT_DIR/toyc.sls" "$@"

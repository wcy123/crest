#!r6rs
;; Mirrors mlir/Interfaces/FunctionInterfaces.h
(library (mlir Interfaces FunctionInterfaces)
  (export mlir::function_interface_impl::parseFunctionOp
          crest::FunctionOpInterface::getInterfaceID
          crest::SymbolOpInterface::getInterfaceID
          crest::ArgAndResultAttrsOpInterface::getInterfaceID
          crest::CallableOpInterface::getInterfaceID
          crest::FunctionOpInterface::getConcept
          crest::FunctionOpInterface::setSchemeDispatch
          crest::FunctionOpInterface::getSchemeConceptPtr
          mlir::FunctionOpInterface
          mlir::function_interface_impl::printFunctionOp)
  (import (rnrs)
          (mlir Interfaces FunctionInterfaces ffi))

  (define mlir::function_interface_impl::parseFunctionOp
    %mlir::function_interface_impl::parseFunctionOp)

  (define crest::FunctionOpInterface::getInterfaceID
    %crest::FunctionOpInterface::getInterfaceID)

  (define crest::SymbolOpInterface::getInterfaceID
    %crest::SymbolOpInterface::getInterfaceID)

  (define crest::ArgAndResultAttrsOpInterface::getInterfaceID
    %crest::ArgAndResultAttrsOpInterface::getInterfaceID)

  (define crest::CallableOpInterface::getInterfaceID
    %crest::CallableOpInterface::getInterfaceID)

  (define crest::FunctionOpInterface::getConcept
    %crest::FunctionOpInterface::getConcept)

  (define crest::FunctionOpInterface::setSchemeDispatch
    %crest::FunctionOpInterface::setSchemeDispatch)

  (define crest::FunctionOpInterface::getSchemeConceptPtr
    %crest::FunctionOpInterface::getSchemeConceptPtr)

  ;; mlir::FunctionOpInterface — interface specification as a Scheme procedure.
  ;;
  ;; This procedure is the fallback for per-op dispatch procs generated by
  ;; :interfaces ((mlir::FunctionOpInterface method-clause ...)).  It encodes
  ;; MLIR's own required/optional distinction:
  ;;
  ;;   Required (no MLIR default) — errors so the op author knows they must
  ;;   override:
  ;;     getFunctionType, setFunctionTypeAttr, cloneTypeWith
  ;;
  ;;   Optional (MLIR provides a default) — implemented here:
  ;;     verifyBody  → always succeeds
  ;;     verifyType  → always succeeds
  ;;
  ;;   C++-only (TypeRange cannot cross the Scheme/C++ boundary) — cloneTypeWith
  ;;   is handled directly in g_scheme_fop_concept and never reaches Scheme; it
  ;;   is listed under required above to prevent silent wrong behaviour if the
  ;;   routing ever changes.
  (define (mlir::FunctionOpInterface method)
    (case method
      ((getFunctionType)
       (error "mlir::FunctionOpInterface"
              "getFunctionType is required — override it in :interfaces"))
      ((setFunctionTypeAttr)
       (error "mlir::FunctionOpInterface"
              "setFunctionTypeAttr is required — override it in :interfaces"))
      ((cloneTypeWith)
       (error "mlir::FunctionOpInterface"
              "cloneTypeWith cannot be implemented in Scheme (TypeRange boundary)"))
      ((verifyBody)
       (lambda (self) (%crest::FunctionOpInterface::default::verifyBody self)))
      ((verifyType)
       (lambda (self) (%crest::FunctionOpInterface::default::verifyType self)))
      (else
       (error "mlir::FunctionOpInterface" "unknown method" method))))

  (define mlir::function_interface_impl::printFunctionOp
    %mlir::function_interface_impl::printFunctionOp)

  ) ;; end library (mlir Interfaces FunctionInterfaces)
